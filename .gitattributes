# Normalise line endings in the repo, let git pick in the working tree.
* text=auto

# PowerShell is Windows-native. Keep CRLF checked out.
*.ps1 text eol=crlf

# fastfetch reads these RAW. No end-of-line conversion, ever — a rewritten byte
# breaks the drawing, and nothing warns you. See terminal/CLAUDE.md.
terminal/ascii-arts/*.txt -text

