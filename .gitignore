# --- Real secrets (only the .example ships) ---
secrets/*
!secrets/.env.example
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.p12
credentials.json
*token*.json
*secret*.json

# --- Claude live state can contain OAuth data, project metadata, and MCP credentials ---
claude/mcp.json
claude/mcp-servers.json
claude/settings.local.json
claude.json
.credentials.json

# --- State, caches and logs (noise, not configuration) ---
.omc/
.claude/
*.log
node_modules/
__pycache__/
.venv/
venv/

