# ==========================================================
#  Keys to restore by hand after a fresh install.
#
#  1. Copy this file to  secrets/.env
#  2. Fill in the values
#  3. Run:  pwsh claude\install.ps1 -Secrets
#
#  secrets/.env is in .gitignore — it never gets committed.
# ==========================================================

# --- Search / scraping ---
EXA_API_KEY=
FIRECRAWL_API_KEY=

# --- GitHub ---
# For the github MCP server. The CLI uses `gh auth login`, which is separate.
# Scopes you had: gist, read:org, repo, workflow
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- Atlassian ---
JIRA_URL=
JIRA_EMAIL=mateogarcia1660@gmail.com
JIRA_API_TOKEN=
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=mateogarcia1660@gmail.com
CONFLUENCE_API_TOKEN=

# --- AI / media ---
OPENAI_API_KEY=
FAL_KEY=

# --- Browser automation ---
BROWSERBASE_API_KEY=

# ==========================================================
#  Where to regenerate each one:
#
#    EXA             dashboard.exa.ai
#    FIRECRAWL       firecrawl.dev/app/api-keys
#    GITHUB PAT      github.com/settings/tokens
#    JIRA            id.atlassian.com/manage-profile/security/api-tokens
#    CONFLUENCE      same as Jira (one token covers both)
#    OPENAI          platform.openai.com/api-keys
#    FAL             fal.ai/dashboard/keys
#    BROWSERBASE     browserbase.com/settings
# ==========================================================
