# ==========================================================
#  Keys to restore by hand after a fresh install.
#
#  1. Copy this file to  secrets/.env
#  2. Fill in the values
#  3. Run:  pwsh claude\install.ps1 -Secrets
#
#  secrets/.env is in .gitignore — it never gets committed.
# ==========================================================

# --- GitHub ---
# For the hosted GitHub MCP server. The CLI uses `gh auth login`, which is separate.
# Scopes you had: gist, read:org, repo, workflow
GITHUB_PERSONAL_ACCESS_TOKEN=

# ==========================================================
#  Where to regenerate each one:
#
#    GITHUB PAT      github.com/settings/tokens
# ==========================================================
