{
  // --- Editor / UX ---
  "editor.wordWrap": "bounded",
  "editor.wordWrapColumn": 120,
  "editor.rulers": [120],

  "editor.minimap.enabled": false,
  "breadcrumbs.enabled": false,

  "editor.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,

  "editor.cursorStyle": "line",
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",

  "editor.renderLineHighlight": "all",
  "editor.guides.bracketPairs": "active",
  "editor.bracketPairColorization.enabled": true,
  "editor.linkedEditing": true,
  "editor.inlineSuggest.enabled": true,

  "editor.fontFamily": "JetBrainsMono NFM, Consolas, monospace",
  "terminal.integrated.fontFamily": "JetBrainsMono NFM",
  "editor.fontLigatures": true,
  "editor.tabSize": 4,
  "editor.detectIndentation": true,

  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.simpleDialog.enable": true,

  // --- Emmet ---
  "emmet.includeLanguages": {
    "javascript": "javascriptreact",
  },

  // --- Formatting / Save Actions ---
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit",
  },

  // --- Prettier (por lenguaje, como ya tenías) ---
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[dockercompose]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

  // --- Workbench ---
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": false,
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.sideBar.location": "right",
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "window.menuBarVisibility": "compact",

  // --- Theme (dejé esto “neutral”: tu colorCustomizations no hacía nada real) ---
  "workbench.colorCustomizations": {
    "[Material Theme Darker High Contrast]": {},
  },

  // --- Live Server ---
  "liveServer.settings.donotVerifyTags": true,
  "liveServer.settings.donotShowInfoMsg": true,

  // --- Terminal (PRO: PS7 si lo tenés) ---
  // Si tu perfil se llama distinto, elegilo desde: Terminal > Select Default Profile
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",

  // --- Copilot ---
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "yaml": false,
    "css": true,
  },
  "github.copilot.nextEditSuggestions.enabled": true,

  // --- GitLens (lo dejo como estaba) ---
  "gitlens.ai.model": "vscode",
  "gitlens.ai.vscode.model": "copilot:gpt-4.1",

  // --- Chat / Agentes (ojo: algunas keys pueden ser ignoradas según versión/extensión) ---
  "chat.agent.maxRequests": 1000,
  "github.copilot.chat.anthropic.thinking.budgetTokens": 32000,

  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    ".claude/rules": true,
    "~/.copilot/instructions": true,
    "~/.claude/rules": true,
    "C:\\Users\\USER\\AppData\\Local\\Temp\\postman-collections-post-response.instructions.md": true,
    "C:\\Users\\USER\\AppData\\Local\\Temp\\postman-collections-pre-request.instructions.md": true,
    "C:\\Users\\USER\\AppData\\Local\\Temp\\postman-folder-post-response.instructions.md": true,
    "C:\\Users\\USER\\AppData\\Local\\Temp\\postman-folder-pre-request.instructions.md": true,
    "C:\\Users\\USER\\AppData\\Local\\Temp\\postman-http-request-post-response.instructions.md": true,
    "C:\\Users\\USER\\AppData\\Local\\Temp\\postman-http-request-pre-request.instructions.md": true,
    "C:\\Users\\mateo\\AppData\\Local\\Temp\\postman-collections-post-response.instructions.md": true,
    "C:\\Users\\mateo\\AppData\\Local\\Temp\\postman-collections-pre-request.instructions.md": true,
    "C:\\Users\\mateo\\AppData\\Local\\Temp\\postman-folder-post-response.instructions.md": true,
    "C:\\Users\\mateo\\AppData\\Local\\Temp\\postman-folder-pre-request.instructions.md": true,
    "C:\\Users\\mateo\\AppData\\Local\\Temp\\postman-http-request-post-response.instructions.md": true,
    "C:\\Users\\mateo\\AppData\\Local\\Temp\\postman-http-request-pre-request.instructions.md": true,
    "C:\\Users\\Alumno\\AppData\\Local\\Temp\\postman-collections-post-response.instructions.md": true,
    "C:\\Users\\Alumno\\AppData\\Local\\Temp\\postman-collections-pre-request.instructions.md": true,
    "C:\\Users\\Alumno\\AppData\\Local\\Temp\\postman-folder-post-response.instructions.md": true,
    "C:\\Users\\Alumno\\AppData\\Local\\Temp\\postman-folder-pre-request.instructions.md": true,
    "C:\\Users\\Alumno\\AppData\\Local\\Temp\\postman-http-request-post-response.instructions.md": true,
    "C:\\Users\\Alumno\\AppData\\Local\\Temp\\postman-http-request-pre-request.instructions.md": true
  },

  // --- Auto-approve (⚠️ ojo seguridad) ---
  "chat.tools.terminal.autoApprove": {
    "docker-compose": true,
    "timeout": true,
    "npx": true,
    "docker exec": true,
    "npm run tw:build": true,
  },
  "chat.tools.urls.autoApprove": {
    "https://bystellabotella.com": {
      "approveRequest": true,
      "approveResponse": false,
    },
  },

  // --- Claude Code ext ---
  "workbench.settings.applyToAllProfiles": ["claudeCode.useTerminal"],
  "claudeCode.useTerminal": true,
  "window.commandCenter": false,
  "workbench.activityBar.location": "top",
  "workbench.colorTheme": "Catppuccin Mocha",
  "security.workspace.trust.untrustedFiles": "open",
  "security.allowedUNCHosts": [
    "wsl.localhost"
  ],
}