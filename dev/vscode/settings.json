{
  // --- Editor / UX ---
  "editor.wordWrap": "bounded",
  "editor.wordWrapColumn": 120,
  "editor.rulers": [120],

  "editor.minimap.enabled": false,
  "breadcrumbs.enabled": false,

  "editor.smoothScrolling": true,
  "workbench.list.smoothScrolling": true,

  "editor.cursorStyle": "line",
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",

  "editor.renderLineHighlight": "all",
  "editor.guides.bracketPairs": "active",
  "editor.bracketPairColorization.enabled": true,
  "editor.linkedEditing": true,
  "editor.inlineSuggest.enabled": true,

  // Must match the terminal. JetBrainsMono NFM is what winget actually registers -
  // the long "Nerd Font Mono" form does not exist. See terminal/README.md.
  "editor.fontFamily": "JetBrainsMono NFM, Consolas, monospace",
  "terminal.integrated.fontFamily": "JetBrainsMono NFM",
  "editor.fontLigatures": true,
  "editor.tabSize": 4,
  "editor.detectIndentation": true,

  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.simpleDialog.enable": true,

  // --- Emmet ---
  "emmet.includeLanguages": {
    "javascript": "javascriptreact"
  },

  // --- Formatting / save actions ---
  "editor.codeActionsOnSave": {
    "source.fixAll": "explicit",
    "source.organizeImports": "explicit"
  },

  // --- Prettier, per language ---
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[dockercompose]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },

  // --- Workbench ---
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": false,
  "workbench.colorTheme": "Catppuccin Mocha",
  "workbench.iconTheme": "catppuccin-mocha",
  "workbench.sideBar.location": "right",
  "workbench.activityBar.location": "top",
  "window.commandCenter": false,
  "window.menuBarVisibility": "compact",
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,

  // --- Terminal ---
  // If the profile is named differently: Terminal > Select Default Profile
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",

  // --- Trust ---
  "security.workspace.trust.untrustedFiles": "open",
  "security.allowedUNCHosts": ["wsl.localhost"]
}
